{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "fs:default",
    "fs:read-files",
    "fs:write-files", 
    "fs:allow-mkdir",
    "fs:allow-read-file",
    "fs:allow-write-file", 
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",  
    "fs:scope-home",
    "fs:scope-desktop",
    "fs:scope-appdata"
  ]
}